<Page x:Class="CameraCali.Views.MonoCalibrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:CameraCali.Helpers"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:CameraCali.ViewModels"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      Title="单目标定"
      d:DataContext="{d:DesignInstance Type=vm:MonoCalibrationViewModel}"
      Background="White"
      mc:Ignorable="d">

    <Page.Resources>
        <helpers:BooleanInvertConverter x:Key="BoolInvertConverter" />
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="5,5">
        <Grid.RowDefinitions>
            <!--  操作按钮  -->
            <RowDefinition Height="Auto" />
            <!--  棋盘格配置  -->
            <RowDefinition Height="Auto" />
            <!--  标定结果  -->
            <RowDefinition Height="Auto" />
            <!--  有效图片列表 + 角点预览  -->
            <RowDefinition Height="*" />
            <!--  进度 + 状态  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ═══════════ Row 0: 操作按钮 ═══════════  -->
        <GroupBox Grid.Row="0" Header="Cali">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Margin="5,3">
                    <StackPanel>
                        <Button Command="{Binding ImportImagesCommand}" Content="📂 导入图片" />
                        <TextBlock Text="{Binding PendingCount, StringFormat='待处理: {0} 张'}" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Grid.Column="1">
                    <Button Width="120"
                            Height="36"
                            Margin="5,3"
                            Command="{Binding DetectCornersCommand}"
                            Content="🔍 检测角点"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}" />
                    <Button Width="120"
                            Height="36"
                            Margin="5,3"
                            Command="{Binding StartCalibrationCommand}"
                            Content="🚀 开始标定"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}" />
                    <Button Width="140"
                            Height="36"
                            Margin="5,3"
                            Command="{Binding SaveCalibrationFileCommand}"
                            Content="💾 保存标定文件"
                            FontWeight="SemiBold" />
                    <Button Width="120"
                            Height="36"
                            Margin="5,3"
                            Command="{Binding ClearDataCommand}"
                            Content="🗑 清空数据"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}" />
                </WrapPanel>
            </Grid>

        </GroupBox>

        <!--  ═══════════ Row 1: 棋盘格配置 ═══════════  -->
        <GroupBox Grid.Row="1" Header="棋盘格配置">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Text="内角点列数:" />
                <TextBox Width="50"
                         Margin="5,0,15,0"
                         VerticalAlignment="Center"
                         Text="{Binding ChessboardConfig.CornerCols}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Text="行数:" />
                <TextBox Width="50"
                         Margin="5,0,15,0"
                         VerticalAlignment="Center"
                         Text="{Binding ChessboardConfig.CornerRows}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Text="格子尺寸(mm):" />
                <TextBox Width="60"
                         Margin="5,0,15,0"
                         VerticalAlignment="Center"
                         Text="{Binding ChessboardConfig.SquareSize, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Text="像元尺寸(μm):" />
                <TextBox Width="60"
                         Margin="5,0,15,0"
                         VerticalAlignment="Center"
                         Text="{Binding ChessboardConfig.PixelSizeUm}" />
            </StackPanel>
        </GroupBox>

        <!--  ═══════════ Row 2: 标定结果 ═══════════  -->
        <GroupBox Grid.Row="2"
                  Margin="0,3"
                  Header="标定结果"
                  Visibility="{Binding HasCalibrationResult, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Expander Header="标定结果（点击展开/折叠）" IsExpanded="True">
                <StackPanel>
                    <!--  统计信息卡片  -->
                    <Border Margin="0,5"
                            Padding="5,3"
                            Background="#FAFAFA"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4">
                        <WrapPanel>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#E65100"
                                       Text="{Binding SkippedCount, StringFormat='跳过 {0} 张'}" />
                            <TextBlock Width="20" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#E65100"
                                       Text="{Binding ReprojectionErrorDisplay, StringFormat='重投影误差={0}'}" />
                        </WrapPanel>
                    </Border>

                    <!--  相机内参 + 畸变卡片  -->
                    <Border Padding="5,3"
                            Background="#FAFAFA"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1565C0"
                                       Text="📷 相机内参" />
                            <!--  物理焦距  -->
                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       Foreground="#6A1B9A"
                                       Text="{Binding FocalMm, StringFormat='物理焦距 f = {0} mm'}" />
                            <!--  内参矩阵 K  -->
                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#37474F"
                                       Text="内参矩阵 K"
                                       ToolTip="3×3 相机内参矩阵" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="4,2"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Text="{Binding CalibrationResult.Fx, StringFormat='fx:{0}'}" />
                                </Border>
                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        Padding="4,2"
                                        Background="#FFF8E1"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#9E9E9E"
                                               Text="0" />
                                </Border>
                                <Border Grid.Row="0"
                                        Grid.Column="2"
                                        Padding="4,2"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#E65100"
                                               Text="{Binding CalibrationResult.Cx, StringFormat='Cx:{0}'}" />
                                </Border>
                                <Border Grid.Row="1"
                                        Grid.Column="0"
                                        Padding="4,2"
                                        Background="#FFF8E1"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#9E9E9E"
                                               Text="0" />
                                </Border>
                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Padding="4,2"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Text="{Binding CalibrationResult.Fy, StringFormat='fy:{0}'}" />
                                </Border>
                                <Border Grid.Row="1"
                                        Grid.Column="2"
                                        Padding="4,2"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#E65100"
                                               Text="{Binding CalibrationResult.Cy, StringFormat='Cy:{0}'}" />
                                </Border>
                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        Padding="4,2"
                                        Background="#FFF8E1"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#9E9E9E"
                                               Text="0" />
                                </Border>
                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Padding="4,2"
                                        Background="#FFF8E1"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#9E9E9E"
                                               Text="0" />
                                </Border>
                                <Border Grid.Row="2"
                                        Grid.Column="2"
                                        Padding="4,2"
                                        Background="#FFF8E1"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#9E9E9E"
                                               Text="1" />
                                </Border>
                            </Grid>
                            <!--  畸变系数 D  -->
                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#37474F"
                                       Text="畸变系数 D"
                                       ToolTip="k1,k2=径向, p1,p2=切向, k3=高阶径向" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Text="{Binding CalibrationResult.K1, StringFormat='K1 = {0}'}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Text="{Binding CalibrationResult.K2, StringFormat='K2 = {0}'}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Text="{Binding CalibrationResult.K3, StringFormat='K3 = {0}'}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Text="{Binding CalibrationResult.P1, StringFormat='P1 = {0}'}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Text="{Binding CalibrationResult.P2, StringFormat='P2 = {0}'}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </GroupBox>

        <!--  ═══════════ Row 3: 有效图片列表 + 角点预览 ═══════════  -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="30*" />
            </Grid.ColumnDefinitions>

            <!--  有效图片列表  -->
            <GroupBox Grid.Column="0" Header="有效图片">
                <DataGrid AutoGenerateColumns="False"
                          BorderThickness="0"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Disabled"
                          IsReadOnly="True"
                          ItemsSource="{Binding ValidImages}"
                          SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                          SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F5F5F5" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="BorderBrush" Value="#E0E0E0" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="3,3" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#E0E0E0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="FontSize" Value="11" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="FontSize" Value="11" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="36"
                                            Binding="{Binding Index}"
                                            CanUserSort="True"
                                            Header="#">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding FileName}"
                                            CanUserSort="True"
                                            Header="文件名">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip" Value="{Binding ImagePath}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="50"
                                            Binding="{Binding CornerStatus}"
                                            CanUserSort="True"
                                            Header="角点">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#2E7D32" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="56"
                                                CanUserSort="False"
                                                Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="45"
                                            Height="20"
                                            Padding="0"
                                            Background="#e74c3c"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="删除"
                                            Cursor="Hand"
                                            FontSize="10"
                                            Foreground="White" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter Grid.Column="0"
                          Width="4"
                          VerticalAlignment="Stretch"
                          Background="#E0E0E0" />

            <!--  角点预览（选中列表项后显示）  -->
            <GroupBox Grid.Column="1" Header="角点绘制预览（选中列表项查看）">
                <Border Background="#FAFAFA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <xctk:Zoombox Name="ZoomBox"
                                  IsUsingScrollBars="True"
                                  KeepContentInBounds="False"
                                  RelativeZoomModifiers="ctrl">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Loaded">
                                <i:CallMethodAction MethodName="FitToBounds" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Grid>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                        </Grid>
                    </xctk:Zoombox>
                </Border>
            </GroupBox>
        </Grid>

        <!--  ═══════════ Row 4: 进度 + 状态 ═══════════  -->
        <Border Grid.Row="4"
                Padding="8"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Height="6"
                             Margin="0,0,0,4"
                             Background="#E0E0E0"
                             Foreground="#1976D2"
                             Maximum="100"
                             Minimum="0"
                             Value="{Binding ProgressValue}" />
                <TextBlock Grid.Row="1"
                           FontSize="12"
                           Foreground="#424242"
                           Text="{Binding StatusText}"
                           TextWrapping="WrapWithOverflow" />
            </Grid>
        </Border>
    </Grid>

</Page>
