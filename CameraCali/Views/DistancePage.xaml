<Page x:Class="CameraCali.Views.DistancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:CameraCali.Helpers"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:CameraCali.ViewModels"
      Title="双目测距"
      d:DataContext="{d:DesignInstance Type=vm:DistanceViewModel}"
      Background="White"
      mc:Ignorable="d">

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:BooleanInvertConverter x:Key="BoolInvertConverter" />
    </Page.Resources>

    <ScrollViewer>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  标定参数加载 + 展示  -->
                <RowDefinition Height="Auto" />
                <!--  图像显示区域  -->
                <RowDefinition Height="Auto" />
                <!--  距离测算  -->
                <RowDefinition Height="Auto" />
                <!--  状态栏  -->
            </Grid.RowDefinitions>

            <!--  ═══════════ Row 0: 标定参数加载 + 展示 ═══════════  -->
            <StackPanel Grid.Row="0">

                <!--  加载栏  -->
                <GroupBox Margin="0,0,0,8"
                          Padding="8"
                          Header="标定文件">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Text="标定文件：" />
                        <TextBox MinWidth="420"
                                 Margin="0,0,8,0"
                                 Padding="2,5"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 IsReadOnly="True"
                                 Text="{Binding CalibrationFilePath, Mode=OneWay}" />
                        <Button Width="140"
                                Height="30"
                                Command="{Binding LoadCalibrationCommand}"
                                Content="📂 加载标定文件"
                                FontSize="12" />
                    </WrapPanel>
                </GroupBox>

                <!--  标定参数展示（加载后可见）  -->
                <GroupBox Margin="0,0,0,8"
                          Padding="8"
                          Header="标定参数"
                          Visibility="{Binding HasCalibration, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  左右相机内参 + 畸变卡片  -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  左相机卡片  -->
                            <Border Grid.Column="0"
                                    Padding="8,6"
                                    Background="#FAFAFA"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1565C0"
                                               Text="📷 左相机" />
                                    <!--  内参矩阵 K  -->
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#37474F"
                                               Text="内参矩阵 K"
                                               ToolTip="3×3 相机内参矩阵" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!--  Col 表头  -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" />
                                        <Border Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="5,2"
                                                Background="#F5F5F5"
                                                BorderBrush="#E8E8E8"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Text="Col 1" />
                                        </Border>
                                        <Border Grid.Row="0"
                                                Grid.Column="2"
                                                Padding="5,2"
                                                Background="#F5F5F5"
                                                BorderBrush="#E8E8E8"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Text="Col 2" />
                                        </Border>
                                        <Border Grid.Row="0"
                                                Grid.Column="3"
                                                Padding="5,2"
                                                Background="#F5F5F5"
                                                BorderBrush="#E8E8E8"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Text="Col 3" />
                                        </Border>
                                        <!--  Row 1  -->
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="#616161"
                                                   Text="Row 1" />
                                        <Border Grid.Row="1"
                                                Grid.Column="1"
                                                Padding="5,2"
                                                Background="White"
                                                BorderBrush="#E8E8E8"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Text="{Binding LeftFx}" />
                                        </Border>
                                        <Border Grid.Row="1"
                                                Grid.Column="2"
                                                Padding="5,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="#9E9E9E"
                                                       Text="0" />
                                        </Border>
                                        <Border Grid.Row="1"
                                                Grid.Column="3"
                                                Padding="5,2"
                                                Background="White"
                                                BorderBrush="#E8E8E8"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="#E65100"
                                                       Text="{Binding LeftCx}" />
                                        </Border>
                                        <!--  Row 2  -->
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="#616161"
                                                   Text="Row 2" />
                                        <Border Grid.Row="2"
                                                Grid.Column="1"
                                                Padding="5,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="#9E9E9E"
                                                       Text="0" />
                                        </Border>
                                        <Border Grid.Row="2"
                                                Grid.Column="2"
                                                Padding="5,2"
                                                Background="White"
                                                BorderBrush="#E8E8E8"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Text="{Binding LeftFy}" />
                                        </Border>
                                        <Border Grid.Row="2"
                                                Grid.Column="3"
                                                Padding="5,2"
                                                Background="White"
                                                BorderBrush="#E8E8E8"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="#E65100"
                                                       Text="{Binding LeftCy}" />
                                        </Border>
                                        <!--  Row 3  -->
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="#616161"
                                                   Text="Row 3" />
                                        <Border Grid.Row="3"
                                                Grid.Column="1"
                                                Padding="5,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="#9E9E9E"
                                                       Text="0" />
                                        </Border>
                                        <Border Grid.Row="3"
                                                Grid.Column="2"
                                                Padding="5,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="#9E9E9E"
                                                       Text="0" />
                                        </Border>
                                        <Border Grid.Row="3"
                                                Grid.Column="3"
                                                Padding="5,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="#9E9E9E"
                                                       Text="1" />
                                        </Border>
                                    </Grid>
                                    <!--  畸变系数 D  -->
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#37474F"
                                               Text="畸变系数 D"
                                               ToolTip="k1,k2=径向, p1,p2=切向, k3=高阶径向" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="k1=" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding LeftK1}" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="k2=" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="3"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding LeftK2}" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="4"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="p1=" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="5"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding LeftP1}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="p2=" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding LeftP2}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="2"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="k3=" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="3"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding LeftK3}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <GridSplitter Grid.Column="1"
                                          Width="4"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="#E0E0E0" />

                            <!--  右相机卡片  -->
                            <Border Grid.Column="2"
                                    Padding="8,6"
                                    Background="#FAFAFA"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1565C0"
                                               Text="📷 右相机" />
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#37474F"
                                               Text="内参矩阵 K"
                                               ToolTip="3×3 相机内参矩阵" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="4,2"
                                                Background="White"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Text="{Binding RightFx}" />
                                        </Border>
                                        <Border Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="4,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#9E9E9E"
                                                       Text="0" />
                                        </Border>
                                        <Border Grid.Row="0"
                                                Grid.Column="2"
                                                Padding="4,2"
                                                Background="White"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#E65100"
                                                       Text="{Binding RightCx}" />
                                        </Border>
                                        <Border Grid.Row="1"
                                                Grid.Column="0"
                                                Padding="4,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#9E9E9E"
                                                       Text="0" />
                                        </Border>
                                        <Border Grid.Row="1"
                                                Grid.Column="1"
                                                Padding="4,2"
                                                Background="White"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Text="{Binding RightFy}" />
                                        </Border>
                                        <Border Grid.Row="1"
                                                Grid.Column="2"
                                                Padding="4,2"
                                                Background="White"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#E65100"
                                                       Text="{Binding RightCy}" />
                                        </Border>
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Padding="4,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#9E9E9E"
                                                       Text="0" />
                                        </Border>
                                        <Border Grid.Row="2"
                                                Grid.Column="1"
                                                Padding="4,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#9E9E9E"
                                                       Text="0" />
                                        </Border>
                                        <Border Grid.Row="2"
                                                Grid.Column="2"
                                                Padding="4,2"
                                                Background="#FFF8E1"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#9E9E9E"
                                                       Text="1" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#37474F"
                                               Text="畸变系数 D" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="k1=" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding RightK1}" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="k2=" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="3"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding RightK2}" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="4"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="p1=" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="5"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding RightP1}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="p2=" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding RightP2}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="2"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#616161"
                                                   Text="k3=" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="3"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding RightK3}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  外参 + 重投影误差  -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0"
                                       Height="1"
                                       Margin="0,10,0,8"
                                       Fill="#E0E0E0" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!--  R 矩阵  -->
                                <Border Grid.Column="0"
                                        Padding="8,6"
                                        Background="#FAFAFA"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1565C0"
                                                   Text="旋转矩阵 R"
                                                   ToolTip="3×3 正交旋转矩阵" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding R11}" />
                                            </Border>
                                            <Border Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding R12}" />
                                            </Border>
                                            <Border Grid.Row="0"
                                                    Grid.Column="2"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding R13}" />
                                            </Border>
                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding R21}" />
                                            </Border>
                                            <Border Grid.Row="1"
                                                    Grid.Column="1"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding R22}" />
                                            </Border>
                                            <Border Grid.Row="1"
                                                    Grid.Column="2"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding R23}" />
                                            </Border>
                                            <Border Grid.Row="2"
                                                    Grid.Column="0"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding R31}" />
                                            </Border>
                                            <Border Grid.Row="2"
                                                    Grid.Column="1"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding R32}" />
                                            </Border>
                                            <Border Grid.Row="2"
                                                    Grid.Column="2"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding R33}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!--  T 向量  -->
                                <Border Grid.Column="2"
                                        MinWidth="130"
                                        Padding="8,6"
                                        Background="#FAFAFA"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Margin="0,0,0,6"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2E7D32"
                                                       Text="平移向量 T (mm)"
                                                       ToolTip="3×1 平移向量 (mm)" />
                                        </WrapPanel>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#2E7D32"
                                                       Text="Tx" />
                                            <Border Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Tx}" />
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="0"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#2E7D32"
                                                       Text="Ty" />
                                            <Border Grid.Row="1"
                                                    Grid.Column="1"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Ty}" />
                                            </Border>
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="0"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#2E7D32"
                                                       Text="Tz" />
                                            <Border Grid.Row="2"
                                                    Grid.Column="1"
                                                    Padding="5,2"
                                                    Background="White"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="1">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Tz}" />
                                            </Border>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </GroupBox>
            </StackPanel>

            <!--  ═══════════ Row 1: 图像显示区域 ═══════════  -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  左图  -->
                    <GroupBox Grid.Column="0" Header="左相机图像（点击选择测量点）">
                        <Grid>
                            <Image Source="{Binding LeftImage}" Stretch="Uniform" />
                            <Canvas x:Name="LeftImageCanvas"
                                    Background="Transparent"
                                    MouseDown="LeftImage_MouseDown">
                                <Ellipse Canvas.Left="{Binding MarkerX}"
                                         Canvas.Top="{Binding MarkerY}"
                                         Width="14"
                                         Height="14"
                                         Fill="Transparent"
                                         Stroke="#ff4444"
                                         StrokeThickness="2"
                                         Visibility="{Binding MarkerVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                            </Canvas>
                        </Grid>
                    </GroupBox>

                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Stretch"
                                  Background="#E0E0E0" />

                    <!--  右图  -->
                    <GroupBox Grid.Column="2" Header="右相机图像（点击选择对应点）">
                        <Grid>
                            <Image Source="{Binding RightImage}" Stretch="Uniform" />
                            <Canvas x:Name="RightImageCanvas"
                                    Background="Transparent"
                                    MouseDown="RightImage_MouseDown">
                                <Ellipse Canvas.Left="{Binding RightMarkerX}"
                                         Canvas.Top="{Binding RightMarkerY}"
                                         Width="14"
                                         Height="14"
                                         Fill="Transparent"
                                         Stroke="#ff4444"
                                         StrokeThickness="2"
                                         Visibility="{Binding RightMarkerVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                            </Canvas>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!--  选中点坐标显示  -->
                <Border Grid.Row="1"
                        Margin="0,4,0,0"
                        Padding="6,4"
                        Background="#F5F5F5"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,4,0"
                                   FontSize="11"
                                   Foreground="#6c757d"
                                   Text="左图选中：" />
                        <TextBlock FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#007bff">
                            <Run Text="(" /><Run Text="{Binding SelectedPoint.X, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding SelectedPoint.Y, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <Separator Width="16" Background="Transparent" />
                        <TextBlock Margin="0,0,4,0"
                                   FontSize="11"
                                   Foreground="#6c757d"
                                   Text="右图选中：" />
                        <TextBlock FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#007bff">
                            <Run Text="(" /><Run Text="{Binding RightSelectedPoint.X, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding RightSelectedPoint.Y, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ═══════════ Row 2: 距离测算 ═══════════  -->
            <GroupBox Grid.Row="2"
                      Margin="0,0,0,8"
                      Padding="8"
                      Header="距离测算">
                <StackPanel>
                    <!--  操作按钮  -->
                    <WrapPanel Margin="0,0,0,8">
                        <Button Width="110"
                                Height="30"
                                Margin="2"
                                Command="{Binding ImportLeftImageCommand}"
                                Content="📷 导入左图"
                                FontSize="12" />
                        <Button Width="110"
                                Height="30"
                                Margin="2"
                                Command="{Binding ImportRightImageCommand}"
                                Content="📷 导入右图"
                                FontSize="12" />
                        <Separator Width="10" Background="Transparent" />
                        <Button Width="120"
                                Height="30"
                                Margin="2"
                                Background="#e74c3c"
                                BorderThickness="0"
                                Command="{Binding MeasureDistanceCommand}"
                                Content="📏 SGBM 测距"
                                Cursor="Hand"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White" />
                        <Separator Width="10" Background="Transparent" />
                        <!--  手动坐标输入  -->
                        <TextBlock Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text="左(X,Y):" />
                        <TextBox Width="50"
                                 Height="24"
                                 Margin="1,0,6,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ManualLeftX, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" />
                        <TextBox Width="50"
                                 Height="24"
                                 Margin="1,0,10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ManualLeftY, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" />
                        <TextBlock Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text="右(X,Y):" />
                        <TextBox Width="50"
                                 Height="24"
                                 Margin="1,0,6,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ManualRightX, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" />
                        <TextBox Width="50"
                                 Height="24"
                                 Margin="1,0,8,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ManualRightY, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" />
                        <Button Width="90"
                                Height="26"
                                Margin="2,0,0,0"
                                Background="#8E24AA"
                                BorderThickness="0"
                                Command="{Binding MeasureManualDistanceCommand}"
                                Content="📏 手动测算"
                                Cursor="Hand"
                                FontSize="11"
                                Foreground="White" />
                    </WrapPanel>

                    <!--  距离结果  -->
                    <Border Padding="10,8"
                            Background="#FFF8E1"
                            BorderBrush="#FFC107"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding HasDistanceResult, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="测量结果：" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#c0392b"
                                       Text="{Binding DistanceResult, StringFormat='{}{0:F4} 米'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!--  ═══════════ Row 3: 状态栏 ═══════════  -->
            <Border Grid.Row="3"
                    Padding="10,6"
                    Background="#F8F9FA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="120"
                                 Height="6"
                                 Margin="0,0,10,0"
                                 Background="#E0E0E0"
                                 Foreground="#1976D2"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#495057"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
