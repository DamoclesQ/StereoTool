<Page
    x:Class="StereoTool.Views.StereoCalibrationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:StereoTool.Helpers" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    Title="双目标定"
    Background="#F5F7FA">
    <Page.Resources>
        <helpers:BooleanInvertConverter
            x:Key="Invert" />
        <Style
            TargetType="Button">
            <Setter
                Property="Padding"
                Value="12,7" />
            <Setter
                Property="Margin"
                Value="0,0,6,4" />
            <Setter
                Property="MinHeight"
                Value="32" />
        </Style>
        <Style
            TargetType="GroupBox">
            <Setter
                Property="Margin"
                Value="0,4" />
            <Setter
                Property="Padding"
                Value="8" />
        </Style>
    </Page.Resources>
    <Grid
        Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock
                    Text="双目标定"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    Text="1 添加并分析 → 2 检查角点 → 3 标定 → 4 检查误差与校正图 → 5 排除后重新标定 → 6 导出"
                    Foreground="#526071"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8" />
                <WrapPanel>
                    <Button
                        Content="添加图片对并分析"
                        Command="{Binding ImportImagePairsCommand}" />
                    <Button
                        Content="重新分析"
                        Command="{Binding DetectCornersCommand}" />
                    <Button
                        Content="标定 / 重新标定"
                        Command="{Binding StartCalibrationCommand}"
                        Background="#DCEBFF" />
                    <Button
                        Content="导出 YAML"
                        Command="{Binding SaveCalibrationFileCommand}"
                        IsEnabled="{Binding HasCalibrationResult}" />
                    <Button
                        Content="加载 YAML"
                        Command="{Binding LoadCalibrationFileCommand}" />
                    <Button
                        Content="清空"
                        Command="{Binding ClearDataCommand}" />
                    <Button
                        Content="用于测距"
                        Command="{Binding UseForDistanceCommand}"
                        IsEnabled="{Binding HasCalibrationResult}" />
                </WrapPanel>
            </StackPanel>
            <GroupBox
                Grid.Row="1"
                Header="标定板与相机模型">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock
                            Text="内角点列 / 行"
                            VerticalAlignment="Center" />
                        <xctk:IntegerUpDown
                            Width="58"
                            Margin="6,0"
                            Minimum="2"
                            Value="{Binding ChessboardConfig.CornerCols}" />
                        <xctk:IntegerUpDown
                            Width="58"
                            Margin="0,0,12,0"
                            Minimum="2"
                            Value="{Binding ChessboardConfig.CornerRows}" />
                        <TextBlock
                            Text="格子尺寸 (mm)"
                            VerticalAlignment="Center" />
                        <xctk:DoubleUpDown
                            Width="78"
                            Margin="6,0,12,0"
                            Minimum="0.001"
                            Value="{Binding ChessboardConfig.SquareSize}" />
                        <TextBlock
                            Text="像元 (μm，可选)"
                            VerticalAlignment="Center" />
                        <xctk:DoubleUpDown
                            Width="70"
                            Margin="6,0"
                            Minimum="0"
                            Value="{Binding ChessboardConfig.PixelSizeUm}" />
                    </WrapPanel>
                    <WrapPanel
                        Margin="0,8,0,0"
                        IsEnabled="{Binding CanEditDistortion}">
                        <TextBlock
                            Text="针孔模型：k1、k2；"
                            VerticalAlignment="Center" />
                        <CheckBox
                            Content="估计 k3（第三项径向畸变）"
                            IsChecked="{Binding ChessboardConfig.EstimateK3}"
                            Margin="8,0,16,0" />
                        <CheckBox
                            Content="估计切向畸变 p1、p2"
                            IsChecked="{Binding ChessboardConfig.EstimateTangentialDistortion}" />
                    </WrapPanel>
                    <WrapPanel
                        Margin="0,8,0,0">
                        <CheckBox
                            Content="使用固定内参"
                            IsChecked="{Binding UseFixedIntrinsics}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />
                        <Button
                            Content="导入左右单目 YAML"
                            Command="{Binding LoadFixedIntrinsicsCommand}" />
                        <TextBlock
                            Text="{Binding IntrinsicsSummary}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </WrapPanel>
                    <TextBlock
                        Text="配对规则：同名双目录，或 left01 / right01、left_01 / right_01；缺图保留，编号歧义报错。"
                        FontSize="11"
                        Foreground="#657387"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="这里填写内角点数，不是方格数。建议 10～20 张/对，覆盖画面边缘和多种倾角；最少 3 张/对。"
                        Foreground="#657387"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,6,0,0" />
                </StackPanel>
            </GroupBox>
            <Border
                Grid.Row="2"
                Background="#EAF1FC"
                Padding="8"
                Margin="0,3">
                <StackPanel>
                    <TextBlock
                        Text="{Binding DatasetSummary}" />
                    <TextBlock
                        Text="{Binding ResultSummary}"
                        FontWeight="SemiBold"
                        Margin="0,3,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Grid
                Grid.Row="3"
                Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="460"
                        MinWidth="260" />
                    <ColumnDefinition
                        Width="6" />
                    <ColumnDefinition
                        Width="*"
                        MinWidth="250" />
                </Grid.ColumnDefinitions>
                <DataGrid
                    ItemsSource="{Binding ImagePairs}"
                    SelectedItem="{Binding SelectedPair, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    HeadersVisibility="Column"
                    RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Header="参与"
                            Width="42">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsDetected}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Header="左图"
                            Binding="{Binding LeftFileName}"
                            Width="90" />
                        <DataGridTextColumn
                            Header="右图"
                            Binding="{Binding RightFileName}"
                            Width="90" />
                        <DataGridTextColumn
                            Header="分析结果"
                            Binding="{Binding DetectionStatus}"
                            Width="120" />
                        <DataGridTextColumn
                            Header="误差 px"
                            Binding="{Binding MeanErrorDisplay}"
                            Width="65" />
                        <DataGridTemplateColumn
                            Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Content="移除"
                                        Padding="2"
                                        Margin="0"
                                        Command="{Binding DataContext.DeletePairCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Center"
                    Background="#D2D8E0" />
                <TabControl
                    Grid.Column="2">
                    <TabItem
                        Header="检测点 / 重投影">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Text="彩色连线：检测点；黄色圈：第一个角点；红十字：投影点。Ctrl+滚轮缩放。"
                                TextWrapping="Wrap"
                                Margin="8"
                                Foreground="#526071" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Margin="4"
                                    BorderBrush="#D2D8E0"
                                    BorderThickness="1">
                                    <xctk:Zoombox
                                        IsUsingScrollBars="True"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger
                                                EventName="Loaded">
                                                <i:CallMethodAction
                                                    MethodName="FitToBounds"
                                                    TargetObject="{Binding RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <Image
                                            Source="{Binding LeftPreviewImage, NotifyOnTargetUpdated=True}"
                                            TargetUpdated="PreviewImage_TargetUpdated"
                                            Stretch="Uniform" />
                                    </xctk:Zoombox>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="4"
                                    BorderBrush="#D2D8E0"
                                    BorderThickness="1">
                                    <xctk:Zoombox
                                        IsUsingScrollBars="True"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger
                                                EventName="Loaded">
                                                <i:CallMethodAction
                                                    MethodName="FitToBounds"
                                                    TargetObject="{Binding RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <Image
                                            Source="{Binding RightPreviewImage, NotifyOnTargetUpdated=True}"
                                            TargetUpdated="PreviewImage_TargetUpdated"
                                            Stretch="Uniform" />
                                    </xctk:Zoombox>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem
                        Header="双目校正检查">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Text="标定后检查对应角点是否位于相同水平线；绿色线为校正后同一行。"
                                TextWrapping="Wrap"
                                Margin="8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Margin="4"
                                    BorderBrush="#D2D8E0"
                                    BorderThickness="1">
                                    <xctk:Zoombox
                                        IsUsingScrollBars="True"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger
                                                EventName="Loaded">
                                                <i:CallMethodAction
                                                    MethodName="FitToBounds"
                                                    TargetObject="{Binding RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <Image
                                            Source="{Binding RectifiedLeftImage, NotifyOnTargetUpdated=True}"
                                            TargetUpdated="PreviewImage_TargetUpdated"
                                            Stretch="Uniform" />
                                    </xctk:Zoombox>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="4"
                                    BorderBrush="#D2D8E0"
                                    BorderThickness="1">
                                    <xctk:Zoombox
                                        IsUsingScrollBars="True"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger
                                                EventName="Loaded">
                                                <i:CallMethodAction
                                                    MethodName="FitToBounds"
                                                    TargetObject="{Binding RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <Image
                                            Source="{Binding RectifiedRightImage, NotifyOnTargetUpdated=True}"
                                            TargetUpdated="PreviewImage_TargetUpdated"
                                            Stretch="Uniform" />
                                    </xctk:Zoombox>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem
                        Header="误差与筛选">
                        <DockPanel
                            Margin="8">
                            <StackPanel
                                DockPanel.Dock="Top">
                                <TextBlock
                                        Text="逐对平均重投影误差（px）。横条范围 0～3 px，超出范围时仍显示实际数值。"
                                    TextWrapping="Wrap"
                                    Foreground="#526071" />
                                <WrapPanel
                                    Margin="0,8">
                                    <TextBlock
                                        Text="排除大于"
                                        VerticalAlignment="Center" />
                                    <xctk:DoubleUpDown
                                        Width="75"
                                        Margin="6,0"
                                        Minimum="0"
                                        Increment="0.1"
                                        Value="{Binding ErrorThreshold}" />
                                    <TextBlock
                                        Text="px"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                    <Button
                                        Content="排除高误差图片"
                                        Command="{Binding ExcludeHighErrorCommand}" />
                                </WrapPanel>
                                <TextBlock
                                    Text="筛选后需重新标定。排除记录仍保留，可重新勾选；误差为上一轮拟合结果。"
                                    TextWrapping="Wrap"
                                    Foreground="#657387"
                                    Margin="0,0,0,8" />
                            </StackPanel>
                            <ListBox
                                ItemsSource="{Binding ImagePairs}"
                                SelectedItem="{Binding SelectedPair, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Margin="0,4">
                                            <CheckBox
                                                IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsDetected}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />
                                            <TextBlock
                                                Text="{Binding LeftFileName}"
                                                Width="110"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <Border
                                                Width="300"
                                                Height="16"
                                                Background="#EEF1F5">
                                                <Rectangle
                                                    Width="{Binding ErrorBarWidth}"
                                                    HorizontalAlignment="Left"
                                                    Fill="#4A90D9" />
                                            </Border>
                                            <TextBlock
                                                Text="{Binding MeanErrorDisplay}"
                                                Margin="8,0"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem
                        Header="参数">
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                Margin="12">
                                <TextBlock
                                    Text="{Binding ResultSummary}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding LeftFocalMm, StringFormat=左相机物理焦距：{0}}" />
                                <TextBlock
                                    Text="{Binding RightFocalMm, StringFormat=右相机物理焦距：{0}}" />
                                <TextBlock
                                    Text="左相机内参"
                                    FontWeight="Bold"
                                    Margin="0,12,0,4" />
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Fx: " />
                                    <Run
                                        Text="{Binding CalibrationResult.LeftFx, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Fy: " />
                                    <Run
                                        Text="{Binding CalibrationResult.LeftFy, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Cx: " />
                                    <Run
                                        Text="{Binding CalibrationResult.LeftCx, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Cy: " />
                                    <Run
                                        Text="{Binding CalibrationResult.LeftCy, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="K1: " />
                                    <Run
                                        Text="{Binding CalibrationResult.LeftK1, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="K2: " />
                                    <Run
                                        Text="{Binding CalibrationResult.LeftK2, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="P1: " />
                                    <Run
                                        Text="{Binding CalibrationResult.LeftP1, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="P2: " />
                                    <Run
                                        Text="{Binding CalibrationResult.LeftP2, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="K3: " />
                                    <Run
                                        Text="{Binding CalibrationResult.LeftK3, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Text="右相机内参"
                                    FontWeight="Bold"
                                    Margin="0,12,0,4" />
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Fx: " />
                                    <Run
                                        Text="{Binding CalibrationResult.RightFx, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Fy: " />
                                    <Run
                                        Text="{Binding CalibrationResult.RightFy, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Cx: " />
                                    <Run
                                        Text="{Binding CalibrationResult.RightCx, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Cy: " />
                                    <Run
                                        Text="{Binding CalibrationResult.RightCy, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="K1: " />
                                    <Run
                                        Text="{Binding CalibrationResult.RightK1, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="K2: " />
                                    <Run
                                        Text="{Binding CalibrationResult.RightK2, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="P1: " />
                                    <Run
                                        Text="{Binding CalibrationResult.RightP1, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="P2: " />
                                    <Run
                                        Text="{Binding CalibrationResult.RightP2, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="K3: " />
                                    <Run
                                        Text="{Binding CalibrationResult.RightK3, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Text="外参：Xright = R · Xleft + T，T 单位为 mm"
                                    FontWeight="Bold"
                                    Margin="0,12,0,4" />
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Tx: " />
                                    <Run
                                        Text="{Binding CalibrationResult.Tx, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Ty: " />
                                    <Run
                                        Text="{Binding CalibrationResult.Ty, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="Tz: " />
                                    <Run
                                        Text="{Binding CalibrationResult.Tz, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="R11: " />
                                    <Run
                                        Text="{Binding CalibrationResult.R11, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="R12: " />
                                    <Run
                                        Text="{Binding CalibrationResult.R12, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="R13: " />
                                    <Run
                                        Text="{Binding CalibrationResult.R13, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="R21: " />
                                    <Run
                                        Text="{Binding CalibrationResult.R21, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="R22: " />
                                    <Run
                                        Text="{Binding CalibrationResult.R22, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="R23: " />
                                    <Run
                                        Text="{Binding CalibrationResult.R23, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="R31: " />
                                    <Run
                                        Text="{Binding CalibrationResult.R31, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="R32: " />
                                    <Run
                                        Text="{Binding CalibrationResult.R32, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="R33: " />
                                    <Run
                                        Text="{Binding CalibrationResult.R33, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="E11: " />
                                    <Run
                                        Text="{Binding CalibrationResult.E11, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="E12: " />
                                    <Run
                                        Text="{Binding CalibrationResult.E12, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="E13: " />
                                    <Run
                                        Text="{Binding CalibrationResult.E13, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="E21: " />
                                    <Run
                                        Text="{Binding CalibrationResult.E21, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="E22: " />
                                    <Run
                                        Text="{Binding CalibrationResult.E22, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="E23: " />
                                    <Run
                                        Text="{Binding CalibrationResult.E23, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="E31: " />
                                    <Run
                                        Text="{Binding CalibrationResult.E31, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="E32: " />
                                    <Run
                                        Text="{Binding CalibrationResult.E32, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="E33: " />
                                    <Run
                                        Text="{Binding CalibrationResult.E33, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="F11: " />
                                    <Run
                                        Text="{Binding CalibrationResult.F11, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="F12: " />
                                    <Run
                                        Text="{Binding CalibrationResult.F12, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="F13: " />
                                    <Run
                                        Text="{Binding CalibrationResult.F13, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="F21: " />
                                    <Run
                                        Text="{Binding CalibrationResult.F21, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="F22: " />
                                    <Run
                                        Text="{Binding CalibrationResult.F22, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="F23: " />
                                    <Run
                                        Text="{Binding CalibrationResult.F23, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="F31: " />
                                    <Run
                                        Text="{Binding CalibrationResult.F31, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="F32: " />
                                    <Run
                                        Text="{Binding CalibrationResult.F32, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3">
                                    <Run
                                        Text="F33: " />
                                    <Run
                                        Text="{Binding CalibrationResult.F33, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <StackPanel
            Grid.Row="1"
            Margin="0,8,0,0">
            <ProgressBar
                Height="5"
                Minimum="0"
                Maximum="100"
                Value="{Binding Progress}"
                IsIndeterminate="{Binding IsBusy}" />
            <DockPanel
                Margin="0,6,0,0">
                <Button
                    DockPanel.Dock="Right"
                    Content="停止图片分析"
                    Command="{Binding CancelAnalysisCommand}"
                    IsEnabled="{Binding IsBusy}" />
                <TextBlock
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Page>
