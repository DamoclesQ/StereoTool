                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Center"
                Background="Transparent" />
            <Border
                Grid.Column="4"
                Style="{StaticResource Card}">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock
                            Text="标定设置"
                            Style="{StaticResource SectionTitle}" />
                        <TextBlock
                            Text="内角点 · 列 × 行"
                            Style="{StaticResource Hint}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition
                                    Width="12" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <xctk:IntegerUpDown
                                Minimum="2"
                                Value="{Binding ChessboardConfig.CornerCols}" />
                            <xctk:IntegerUpDown
                                Grid.Column="2"
                                Minimum="2"
                                Value="{Binding ChessboardConfig.CornerRows}" />
                        </Grid>
                        <TextBlock
                            Text="格子尺寸 (mm)"
                            Style="{StaticResource Hint}"
                            Margin="0,12,0,6" />
                        <xctk:DoubleUpDown
                            Minimum="0.001"
                            Value="{Binding ChessboardConfig.SquareSize}" />
                        <TextBlock
                            Text="填写内角点数。建议 10～20 对，覆盖画面边缘和不同倾角。"
                            Style="{StaticResource Hint}" />
                        <Separator
                            Margin="0,12"
                            Background="#E2E8F0" />
                        <TextBlock
                            Text="针孔模型 · k1、k2"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6" />
                        <StackPanel
                            IsEnabled="{Binding CanEditDistortion}">
                            <CheckBox
                                Content="估计 k3 径向畸变"
                                IsChecked="{Binding ChessboardConfig.EstimateK3}" />
                            <CheckBox
                                Content="估计 p1、p2 切向畸变"
                                IsChecked="{Binding ChessboardConfig.EstimateTangentialDistortion}" />
                        </StackPanel>
                        <CheckBox
                            Content="使用固定内参"
                            IsChecked="{Binding UseFixedIntrinsics}"
                            Margin="0,12,0,8" />
                        <Button
                            Content="导入左右单目 YAML"
                            Command="{Binding LoadFixedIntrinsicsCommand}"
                            HorizontalAlignment="Stretch" />
                        <TextBlock
                            Text="{Binding IntrinsicsSummary}"
                            Style="{StaticResource Hint}" />
                        <Separator
                            Margin="0,12"
                            Background="#E2E8F0" />
                        <TextBlock
                            Text="当前结果"
                            Style="{StaticResource SectionTitle}"
                            Margin="0,0,0,8" />
                        <TextBlock
                            Text="{Binding ResultSummary}"
                            TextWrapping="Wrap"
                            LineHeight="22" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <!-- 状态区独立于工作区，运算中仍可取消角点分析。 -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="10,6"
            Background="#EAF0F8"
            CornerRadius="5">
            <DockPanel>
                <Button
                    Content="取消分析"
                    Command="{Binding CancelAnalysisCommand}"
                    DockPanel.Dock="Right"
                    Padding="10,3"
                    MinHeight="24"
                    Margin="8,0,0,0"
                    Visibility="{Binding DetectCornersCommand.IsRunning, Converter={StaticResource BoolVisibility}}" />
                <ProgressBar
                    DockPanel.Dock="Right"
                    Width="96"
                    Height="5"
                    Value="{Binding Progress}"
                    Margin="12,0,0,0" />
                <TextBlock
                    Text="{Binding StatusText}"
                    Foreground="#475569"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Page>
