<Page
    x:Class="StereoTool.Views.StereoCalibrationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    x:Name="PageRoot"
    Title="双目标定"
    Background="#F3F6FA"
    FontFamily="Microsoft YaHei UI">
    <Grid
        Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 顶部按操作顺序排列，设置与结果放在侧栏。 -->
        <StackPanel
            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}"
            Margin="0,0,0,10">
            <DockPanel>
                <TextBlock
                    Text="双目相机标定"
                    Style="{StaticResource PageTitle}"
                    DockPanel.Dock="Left" />
                <TextBlock
                    Text="导入 → 角点分析 → 标定 → 检查与导出"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="#64748B" />
            </DockPanel>
            <TextBlock
                Text="{Binding WorkflowHint}"
                Foreground="#2563EB"
                Margin="0,2,0,12" />
            <WrapPanel>
                <Button
                    Content="① 导入左图"
                    Command="{Binding ImportLeftImagesCommand}" />
                <Button
                    Content="导入右图"
                    Command="{Binding ImportRightImagesCommand}" />
                <Button
                    Content="② 角点分析"
                    Command="{Binding DetectCornersCommand}"
                    IsEnabled="{Binding CanAnalyze}" />
                <Button
                    Content="③ 标定 / 重新标定"
                    Command="{Binding StartCalibrationCommand}"
                    IsEnabled="{Binding CanCalibrate}"
                    Style="{StaticResource PrimaryButton}" />
                <Button
                    Content="加载 YAML"
                    Command="{Binding LoadCalibrationFileCommand}" />
                <Button
                    Content="导出 YAML"
                    Command="{Binding SaveCalibrationFileCommand}"
                    IsEnabled="{Binding HasCalibrationResult}" />
                <Button
                    Content="用于测距 →"
                    Command="{Binding UseForDistanceCommand}"
                    IsEnabled="{Binding HasCalibrationResult}" />
            </WrapPanel>
        </StackPanel>
        <Grid
            Grid.Row="1"
            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="280"
                    MinWidth="200" />
                <ColumnDefinition
                    Width="8" />
                <ColumnDefinition
                    Width="*"
                    MinWidth="250" />
                <ColumnDefinition
                    Width="8" />
                <ColumnDefinition
                    Width="252"
                    MinWidth="220" />
            </Grid.ColumnDefinitions>
            <!-- 图片列表一直可见，选择图片只切换预览，不改变统计口径。 -->
            <Border
                Style="{StaticResource Card}"
                Padding="0">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="12">
                        <DockPanel>
                            <TextBlock
                                Text="图片对"
                                Style="{StaticResource SectionTitle}"
                                DockPanel.Dock="Left" />
                            <Button
                                Content="清空"
                                Command="{Binding ClearDataCommand}"
                                HorizontalAlignment="Right"
                                Padding="7,2"
                                MinHeight="24"
                                Margin="0" />
                        </DockPanel>
                        <TextBlock
                            Text="{Binding DatasetSummary}"
                            Style="{StaticResource Hint}" />
                    </StackPanel>
                    <Button
                        DockPanel.Dock="Bottom"
                        Content="移除选中图片对"
                        Command="{Binding DeletePairCommand}"
                        CommandParameter="{Binding SelectedPair}"
                        Margin="10">
                        <Button.Style>
                            <Style
                                TargetType="Button"
                                BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedPair}"
                                        Value="{x:Null}">
                                        <Setter
                                            Property="IsEnabled"
                                            Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <DataGrid
                        RowHeight="58"
                        ItemsSource="{Binding ImagePairs}"
                        SelectedItem="{Binding SelectedPair, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Header="参与"
                                Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsDetected}"
                                            ToolTip="勾选参与标定，改变后需要重新标定" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Header="左图 / 右图"
                                Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            ToolTip="{Binding DetectionStatus}">
                                            <TextBlock
                                                Text="{Binding LeftFileName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding RightFileName}"
                                                Foreground="#64748B"
                                                FontSize="10"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding DetectionStatus}"
                                                Foreground="#64748B"
                                                FontSize="10"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Header="误差 px"
                                Binding="{Binding MeanErrorDisplay}"
                                Width="65"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Center"
                Background="Transparent" />
            <TabControl
                Grid.Column="2">
                <TabItem
                    Header="角点与投影">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Text="彩色连线：检测点 · 黄色圈：首点 · 红十字：投影点。Ctrl + 滚轮缩放。"
                            Style="{StaticResource Hint}"
                            Margin="12,10" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid
                                    Background="#E9EEF5"
                                    Margin="4">
                                    <TextBlock
                                        Text="导入并选择图片后显示预览"
                                        Foreground="#94A3B8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Margin="18" />
                                    <xctk:Zoombox
                                        IsUsingScrollBars="False"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <Grid
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}">
                                            <Image
                                                Source="{Binding LeftPreviewImage, NotifyOnTargetUpdated=True}"
                                                Stretch="Uniform"
                                                TargetUpdated="PreviewImage_TargetUpdated" />
                                        </Grid>
                                    </xctk:Zoombox>
                                    <Border
                                        Background="#CC0F172A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        IsHitTestVisible="False">
                                        <TextBlock
                                            Text="左相机"
                                            Foreground="White"
                                            FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid
                                Grid.Row="1">
                                <Grid
                                    Background="#E9EEF5"
                                    Margin="4">
                                    <TextBlock
                                        Text="导入并选择图片后显示预览"
                                        Foreground="#94A3B8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Margin="18" />
                                    <xctk:Zoombox
                                        IsUsingScrollBars="False"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <Grid
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}">
                                            <Image
                                                Source="{Binding RightPreviewImage, NotifyOnTargetUpdated=True}"
                                                Stretch="Uniform"
                                                TargetUpdated="PreviewImage_TargetUpdated" />
                                        </Grid>
                                    </xctk:Zoombox>
                                    <Border
                                        Background="#CC0F172A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        IsHitTestVisible="False">
                                        <TextBlock
                                            Text="右相机"
                                            Foreground="White"
                                            FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem
                    Header="双目校正检查">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Text="对照绿色水平线检查左右对应点是否处于同一高度。"
                            Style="{StaticResource Hint}"
                            Margin="12,10" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid
                                    Background="#E9EEF5"
                                    Margin="4">
                                    <TextBlock
                                        Text="标定后显示双目校正图"
                                        Foreground="#94A3B8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Margin="18" />
                                    <xctk:Zoombox
                                        IsUsingScrollBars="False"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <Grid
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}">
                                            <Image
                                                Source="{Binding RectifiedLeftImage, NotifyOnTargetUpdated=True}"
                                                Stretch="Uniform"
                                                TargetUpdated="PreviewImage_TargetUpdated" />
                                        </Grid>
                                    </xctk:Zoombox>
                                    <Border
                                        Background="#CC0F172A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        IsHitTestVisible="False">
                                        <TextBlock
                                            Text="左相机 · 校正后"
                                            Foreground="White"
                                            FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid
                                Grid.Row="1">
                                <Grid
                                    Background="#E9EEF5"
                                    Margin="4">
                                    <TextBlock
                                        Text="标定后显示双目校正图"
                                        Foreground="#94A3B8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Margin="18" />
                                    <xctk:Zoombox
                                        IsUsingScrollBars="False"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <Grid
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}">
                                            <Image
                                                Source="{Binding RectifiedRightImage, NotifyOnTargetUpdated=True}"
                                                Stretch="Uniform"
                                                TargetUpdated="PreviewImage_TargetUpdated" />
                                        </Grid>
                                    </xctk:Zoombox>
                                    <Border
                                        Background="#CC0F172A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        IsHitTestVisible="False">
                                        <TextBlock
                                            Text="右相机 · 校正后"
                                            Foreground="White"
                                            FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem
                    Header="误差与筛选">
                    <DockPanel
                        Margin="14">
                        <StackPanel
                            DockPanel.Dock="Top">
                            <TextBlock
                                Text="剩余参与标定图片对中的最大误差"
                                Style="{StaticResource Hint}" />
                            <StackPanel
                                Orientation="Horizontal"
                                Margin="0,0,0,12">
                                <TextBlock
                                    Text="{Binding RemainingMaxErrorDisplay}"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Foreground="#2563EB" />
                                <TextBlock
                                    Text="px"
                                    Foreground="#64748B"
                                    VerticalAlignment="Bottom"
                                    Margin="8,0,22,5" />
                                <TextBlock
                                    Text="剩余"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,5,5" />
                                <TextBlock
                                    Text="{Binding RemainingCount}"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,4,2" />
                                <TextBlock
                                    Text="对"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,5" />
                            </StackPanel>
                            <WrapPanel>
                                <TextBlock
                                    Text="平均误差 &gt;"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,6" />
                                <xctk:DoubleUpDown
                                    Value="{Binding ErrorThreshold}"
                                    Minimum="0"
                                    Increment="0.1"
                                    FormatString="F3"
                                    Width="80"
                                    Height="32"
                                    Margin="0,0,6,6" />
                                <TextBlock
                                    Text="px"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,6" />
                                <Button
                                    Content="排除高误差"
                                    Command="{Binding ExcludeHighErrorCommand}" />
                                <Button
                                    Content="恢复全选"
                                    Command="{Binding RestoreSelectAllCommand}" />
                            </WrapPanel>
                            <TextBlock
                                Text="列表和误差条均为每对图片的平均重投影误差。筛选后保留上一轮误差，重新标定后更新。"
                                Style="{StaticResource Hint}"
                                Margin="0,4,0,12" />
                        </StackPanel>
                        <ListBox
                            ItemsSource="{Binding ImagePairs}"
                            SelectedItem="{Binding SelectedPair, Mode=TwoWay}"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="100" />
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.Style>
                                            <Style
                                                TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsIncluded}"
                                                        Value="False">
                                                        <Setter
                                                            Property="Opacity"
                                                            Value="0.4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBlock
                                            Text="{Binding LeftFileName}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding LeftFileName}" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            Height="12"
                                            Margin="8,0"
                                            Minimum="0"
                                            Maximum="{Binding DataContext.ErrorChartMaximum, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Value="{Binding ChartError, Mode=OneWay}"
                                            Foreground="#60A5FA"
                                            Background="#EFF6FF"
                                            BorderThickness="0" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding MeanErrorDisplay}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem
                    Header="参数">
                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        Padding="18">
                        <StackPanel>
                            <TextBlock
                                Text="参数以像素和毫米为单位，可通过 YAML 保存。"
                                Style="{StaticResource Hint}" />
                            <TextBlock
                                Style="{StaticResource Hint}">
                                <Run
                                    Text="图像尺寸：" />
                                <Run
                                    Text="{Binding CalibrationResult.ImageWidth, Mode=OneWay}" />
                                <Run
                                    Text=" × " />
                                <Run
                                    Text="{Binding CalibrationResult.ImageHeight, Mode=OneWay}" />
                                <Run
                                    Text=" px" />
                            </TextBlock>
                            <TextBlock
                                Text="左相机 · 内参和畸变"
                                Style="{StaticResource SectionTitle}"
                                Margin="0,12,0,8" />
                            <UniformGrid
                                Columns="2">
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="fx (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.LeftFx, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="fy (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.LeftFy, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="cx (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.LeftCx, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="cy (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.LeftCy, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k1"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.LeftK1, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k2"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.LeftK2, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="p1"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.LeftP1, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="p2"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.LeftP2, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k3"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.LeftK3, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock
                                Text="右相机 · 内参和畸变"
                                Style="{StaticResource SectionTitle}"
                                Margin="0,12,0,8" />
                            <UniformGrid
                                Columns="2">
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="fx (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.RightFx, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="fy (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.RightFy, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="cx (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.RightCx, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="cy (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.RightCy, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k1"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.RightK1, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k2"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.RightK2, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="p1"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.RightP1, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="p2"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.RightP2, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k3"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding CalibrationResult.RightK3, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock
                                Text="旋转矩阵 R · 左相机 → 右相机"
                                Style="{StaticResource SectionTitle}"
                                Margin="0,16,0,8" />
                            <UniformGrid
                                Columns="3">
                                <TextBlock
                                    Text="{Binding CalibrationResult.R11, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding CalibrationResult.R12, TargetNullValue=--, FallbackValue=--}"
