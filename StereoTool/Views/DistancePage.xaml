<Page
    x:Class="StereoTool.Views.DistancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="双目测距"
    Background="#F3F6FA"
    FontFamily="Microsoft YaHei UI">
    <Grid
        Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Margin="0,0,0,10"
            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}">
            <DockPanel>
                <TextBlock
                    Text="双目测距"
                    Style="{StaticResource PageTitle}"
                    DockPanel.Dock="Left" />
                <TextBlock
                    Text="加载参数 → 导入图像 → 校正检查 → 匹配与测量"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="#64748B" />
            </DockPanel>
            <TextBlock
                Text="{Binding WorkflowHint}"
                Foreground="#2563EB"
                Margin="0,2,0,12" />
            <WrapPanel>
                <Button
                    Content="① 加载双目 YAML"
                    Command="{Binding LoadCalibrationCommand}" />
                <Button
                    Content="② 导入左图"
                    Command="{Binding ImportLeftImageCommand}" />
                <Button
                    Content="导入右图"
                    Command="{Binding ImportRightImageCommand}" />
                <Button
                    Content="④ SGBM 匹配"
                    Command="{Binding SgbmComputeCommand}"
                    IsEnabled="{Binding CanCompute}"
                    Style="{StaticResource PrimaryButton}" />
            </WrapPanel>
        </StackPanel>
        <Grid
            Grid.Row="1"
            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*"
                    MinWidth="400" />
                <ColumnDefinition
                    Width="10" />
                <ColumnDefinition
                    Width="282" />
            </Grid.ColumnDefinitions>
            <!-- 图像为主工作区，参数详情按需查看。 -->
            <TabControl>
                <TabItem
                    Header="左右原图">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Text="在左右原图选择同一物理点后，点击右侧“手动对应点测距”。Ctrl + 滚轮缩放。"
                            Style="{StaticResource Hint}"
                            Margin="12,10" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid
                                    Background="#E9EEF5"
                                    Margin="4">
                                    <TextBlock
                                        Text="导入左图后显示预览"
                                        Foreground="#94A3B8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Margin="18" />
                                    <xctk:Zoombox
                                        IsUsingScrollBars="False"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <Grid
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}">
                                            <Image
                                                Source="{Binding LeftImage}"
                                                Stretch="Uniform" />
                                            <Canvas
                                                x:Name="LeftImageCanvas"
                                                Background="Transparent"
                                                SizeChanged="ImageCanvas_SizeChanged"
                                                MouseDown="LeftImage_MouseDown">
                                                <Ellipse
                                                    Width="14"
                                                    Height="14"
                                                    Stroke="#EF4444"
                                                    StrokeThickness="2"
                                                    Canvas.Left="{Binding MarkerX}"
                                                    Canvas.Top="{Binding MarkerY}"
                                                    Visibility="{Binding LeftOriginalMarkerVisible, Converter={StaticResource BoolVisibility}}" />
                                            </Canvas>
                                        </Grid>
                                    </xctk:Zoombox>
                                    <Border
                                        Background="#CC0F172A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        IsHitTestVisible="False">
                                        <TextBlock
                                            Text="左相机 · 原图"
                                            Foreground="White"
                                            FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid
                                Grid.Row="1">
                                <Grid
                                    Background="#E9EEF5"
                                    Margin="4">
                                    <TextBlock
                                        Text="导入右图后显示预览"
                                        Foreground="#94A3B8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Margin="18" />
                                    <xctk:Zoombox
                                        IsUsingScrollBars="False"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <Grid
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}">
                                            <Image
                                                Source="{Binding RightImage}"
                                                Stretch="Uniform" />
                                            <Canvas
                                                x:Name="RightImageCanvas"
                                                Background="Transparent"
                                                SizeChanged="ImageCanvas_SizeChanged"
                                                MouseDown="RightImage_MouseDown">
                                                <Ellipse
                                                    Width="14"
                                                    Height="14"
                                                    Stroke="#EF4444"
                                                    StrokeThickness="2"
                                                    Canvas.Left="{Binding RightMarkerX}"
                                                    Canvas.Top="{Binding RightMarkerY}"
                                                    Visibility="{Binding RightOriginalMarkerVisible, Converter={StaticResource BoolVisibility}}" />
                                            </Canvas>
                                        </Grid>
                                    </xctk:Zoombox>
                                    <Border
                                        Background="#CC0F172A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        IsHitTestVisible="False">
                                        <TextBlock
                                            Text="右相机 · 原图"
                                            Foreground="White"
                                            FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="立体校正检查">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding RectificationHint}"
                                   Style="{StaticResource Hint}"
                                   Margin="12,10" />
                        <Grid Background="#E9EEF5" Margin="4">
                            <TextBlock Text="等待标定参数及左右图片"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRectifiedPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 共同缩放与平移，保持左右图的显示比例和参考行一致。 -->
                            <xctk:Zoombox IsUsingScrollBars="False"
                                          KeepContentInBounds="True"
                                          RelativeZoomModifiers="Ctrl">
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}"
                                      Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding RectifiedLeftImage}" Stretch="Uniform" />
                                    <Image Grid.Column="2" Source="{Binding RectifiedRightImage}" Stretch="Uniform" />
                                </Grid>
                            </xctk:Zoombox>
                            <Border Background="#CC0F172A" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="10" Padding="8,4" CornerRadius="4" IsHitTestVisible="False">
                                <TextBlock Text="左相机 · 立体校正后" Foreground="White" FontSize="11" />
                            </Border>
                            <Border Background="#CC0F172A" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="10" Padding="8,4" CornerRadius="4" IsHitTestVisible="False">
                                <TextBlock Text="右相机 · 立体校正后" Foreground="White" FontSize="11" />
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem
                    Header="视差与深度">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Text="点击图像查看校正左相机坐标系下的 X、Y、Z。黑色区域表示无有效匹配。"
                            Style="{StaticResource Hint}"
                            Margin="12,10" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid
                                    Background="#E9EEF5"
                                    Margin="4">
                                    <TextBlock
                                        Text="执行 SGBM 后显示视差图"
                                        Foreground="#94A3B8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Margin="18" />
                                    <xctk:Zoombox
                                        IsUsingScrollBars="False"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <Grid
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}">
                                            <Image
                                                Source="{Binding DisparityImage}"
                                                Stretch="Uniform" />
                                            <Canvas
                                                x:Name="DisparityImageCanvas"
                                                Background="Transparent"
                                                SizeChanged="ImageCanvas_SizeChanged"
                                                MouseDown="DisparityImage_MouseDown">
                                                <Ellipse
                                                    Width="14"
                                                    Height="14"
                                                    Stroke="#EF4444"
                                                    StrokeThickness="2"
                                                    Canvas.Left="{Binding MarkerX}"
                                                    Canvas.Top="{Binding MarkerY}"
                                                    Visibility="{Binding LeftResultMarkerVisible, Converter={StaticResource BoolVisibility}}" />
                                            </Canvas>
                                        </Grid>
                                    </xctk:Zoombox>
                                    <Border
                                        Background="#CC0F172A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        IsHitTestVisible="False">
                                        <TextBlock
                                            Text="视差 · 归一化灰度"
                                            Foreground="White"
                                            FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid
                                Grid.Row="1">
                                <Grid
                                    Background="#E9EEF5"
                                    Margin="4">
                                    <TextBlock
                                        Text="执行 SGBM 后显示深度图"
                                        Foreground="#94A3B8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Margin="18" />
                                    <xctk:Zoombox
                                        IsUsingScrollBars="False"
                                        KeepContentInBounds="True"
                                        RelativeZoomModifiers="Ctrl">
                                        <Grid
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=xctk:Zoombox}}">
                                            <Image
                                                Source="{Binding ZImage}"
                                                Stretch="Uniform" />
                                            <Canvas
                                                x:Name="ZImageCanvas"
                                                Background="Transparent"
                                                SizeChanged="ImageCanvas_SizeChanged"
                                                MouseDown="ZImage_MouseDown">
                                                <Ellipse
                                                    Width="14"
                                                    Height="14"
                                                    Stroke="#EF4444"
                                                    StrokeThickness="2"
                                                    Canvas.Left="{Binding RightMarkerX}"
                                                    Canvas.Top="{Binding RightMarkerY}"
                                                    Visibility="{Binding RightResultMarkerVisible, Converter={StaticResource BoolVisibility}}" />
                                            </Canvas>
                                        </Grid>
                                    </xctk:Zoombox>
                                    <Border
                                        Background="#CC0F172A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        IsHitTestVisible="False">
                                        <TextBlock
                                            Text="深度 Z · 伪彩色"
                                            Foreground="White"
                                            FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem
                    Header="标定参数">
                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        Padding="18">
                        <StackPanel>
                            <TextBlock
                                Text="参数以像素和毫米为单位，可通过 YAML 保存。"
                                Style="{StaticResource Hint}" />
                            <TextBlock
                                Style="{StaticResource Hint}">
                                <Run
                                    Text="图像尺寸：" />
                                <Run
                                    Text="{Binding LoadedCalibration.ImageWidth, Mode=OneWay}" />
                                <Run
                                    Text=" × " />
                                <Run
                                    Text="{Binding LoadedCalibration.ImageHeight, Mode=OneWay}" />
                                <Run
                                    Text=" px" />
                            </TextBlock>
                            <TextBlock
                                Text="左相机 · 内参和畸变"
                                Style="{StaticResource SectionTitle}"
                                Margin="0,12,0,8" />
                            <UniformGrid
                                Columns="2">
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="fx (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.LeftFx, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="fy (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.LeftFy, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="cx (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.LeftCx, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="cy (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.LeftCy, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k1"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.LeftK1, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k2"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.LeftK2, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="p1"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.LeftP1, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="p2"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.LeftP2, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k3"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.LeftK3, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock
                                Text="右相机 · 内参和畸变"
                                Style="{StaticResource SectionTitle}"
                                Margin="0,12,0,8" />
                            <UniformGrid
                                Columns="2">
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="fx (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.RightFx, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="fy (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.RightFy, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="cx (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.RightCx, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="cy (px)"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.RightCy, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k1"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.RightK1, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k2"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.RightK2, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="p1"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.RightP1, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="p2"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.RightP2, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,16,10">
                                    <TextBlock
                                        Text="k3"
                                        Style="{StaticResource Hint}"
                                        Margin="0,0,0,3" />
                                    <TextBlock
                                        Text="{Binding LoadedCalibration.RightK3, TargetNullValue=--, FallbackValue=--}"
                                        FontFamily="Consolas"
                                        FontSize="14" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock
                                Text="旋转矩阵 R · 左相机 → 右相机"
                                Style="{StaticResource SectionTitle}"
                                Margin="0,16,0,8" />
                            <UniformGrid
                                Columns="3">
                                <TextBlock
                                    Text="{Binding LoadedCalibration.R11, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.R12, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.R13, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.R21, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.R22, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.R23, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.R31, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.R32, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.R33, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                            </UniformGrid>
                            <TextBlock
                                Text="平移向量 T (mm)"
                                Style="{StaticResource SectionTitle}"
                                Margin="0,16,0,8" />
                            <UniformGrid
                                Columns="3">
                                <TextBlock
                                    Text="{Binding LoadedCalibration.Tx, TargetNullValue=--}"
                                    FontFamily="Consolas" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.Ty, TargetNullValue=--}"
                                    FontFamily="Consolas" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.Tz, TargetNullValue=--}"
                                    FontFamily="Consolas" />
                            </UniformGrid>
                            <TextBlock
                                Text="本质矩阵 E"
                                Style="{StaticResource SectionTitle}"
                                Margin="0,16,0,8" />
                            <UniformGrid
                                Columns="3">
                                <TextBlock
                                    Text="{Binding LoadedCalibration.E11, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.E12, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.E13, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.E21, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.E22, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.E23, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.E31, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.E32, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.E33, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                            </UniformGrid>
                            <TextBlock
                                Text="基础矩阵 F"
                                Style="{StaticResource SectionTitle}"
                                Margin="0,16,0,8" />
                            <UniformGrid
                                Columns="3">
                                <TextBlock
                                    Text="{Binding LoadedCalibration.F11, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.F12, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.F13, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.F21, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.F22, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.F23, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.F31, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.F32, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                                <TextBlock
                                    Text="{Binding LoadedCalibration.F33, TargetNullValue=--, FallbackValue=--}"
                                    FontFamily="Consolas"
                                    Margin="0,0,10,8" />
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Border
                Grid.Column="2"
                Style="{StaticResource Card}">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock
                            Text="测量结果"
                            Style="{StaticResource SectionTitle}" />
                        <Border
                            Background="#EFF6FF"
                            CornerRadius="6"
                            Padding="14">
                            <StackPanel>
                                <TextBlock
                                    Text="深度 Z (mm)"
                                    Foreground="#64748B" />
                                <TextBlock
                                    Text="{Binding DepthDisplay}"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="#2563EB"
                                    Margin="0,6,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="X (mm)"
                                            Foreground="#64748B"
                                            FontSize="11" />
                                        <TextBlock
                                            Text="{Binding PointXDisplay}"
                                            FontFamily="Consolas"
                                            Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1">
                                        <TextBlock
                                            Text="Y (mm)"
                                            Foreground="#64748B"
                                            FontSize="11" />
                                        <TextBlock
                                            Text="{Binding PointYDisplay}"
                                            FontFamily="Consolas"
                                            Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Text="坐标系：校正后的左相机；Z 为前向深度。"
                            Style="{StaticResource Hint}" />
                        <Separator
                            Margin="0,12"
                            Background="#E2E8F0" />
                        <TextBlock
                            Text="对应点"
                            Style="{StaticResource SectionTitle}"
                            Margin="0,0,0,8" />
                        <TextBlock
                            Text="{Binding LeftSelectionDisplay}"
                            TextWrapping="Wrap"
                            Margin="0,4" />
                        <TextBlock
                            Text="{Binding RightSelectionDisplay}"
                            TextWrapping="Wrap"
                            Margin="0,4,0,10" />
                        <Button
                            Content="手动对应点测距"
                            Command="{Binding ManuComputeCommand}"
                            IsEnabled="{Binding CanManualMeasure}"
                            HorizontalAlignment="Stretch" />
                        <TextBlock
                            Text="选点后请确认是同一物理位置。手动测距可直接使用左右原图，无需先执行 SGBM。"
                            Style="{StaticResource Hint}" />
                        <Separator
                            Margin="0,12"
                            Background="#E2E8F0" />
                        <Expander
                            Header="当前输入"
                            IsExpanded="True">
                            <StackPanel
                                Margin="0,8,0,0">
                                <TextBlock
                                    Text="{Binding LeftImageSummary}"
                                    Style="{StaticResource Hint}" />
                                <TextBlock
                                    Text="{Binding RightImageSummary}"
                                    Style="{StaticResource Hint}" />
                                <TextBlock
                                    Text="{Binding CalibrationFilePath, TargetNullValue=尚未加载参数}"
                                    Style="{StaticResource Hint}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTip="{Binding CalibrationFilePath}" />
                                <TextBlock
                                    Style="{StaticResource Hint}">
                                    <Run
                                        Text="标定 RMS：" />
                                    <Run
                                        Text="{Binding ReprojectionErrorDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding LoadedCalibration.Baseline, StringFormat=基线：{0:F3} mm, FallbackValue=基线：--}"
                                    Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Expander>
                        <Separator
                            Margin="0,10"
                            Background="#E2E8F0" />
                        <TextBlock
                            Text="导出数据"
                            Style="{StaticResource SectionTitle}"
                            Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button
                                Content="视差 TIFF"
                                Command="{Binding SaveDisparityImageCommand}"
                                IsEnabled="{Binding HasDisparity}" />
                            <Button
                                Content="XYZ TIFF"
                                Command="{Binding SaveXyzImageCommand}"
                                IsEnabled="{Binding HasPointCloud}" />
                        </WrapPanel>
                        <TextBlock
                            Text="TIFF 保留浮点数据。XYZ 为三通道毫米坐标，预览使用伪彩色。"
                            Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="10,8"
            Background="#EAF0F8"
            CornerRadius="5">
            <DockPanel>
                <ProgressBar
                    DockPanel.Dock="Right"
                    Width="96"
                    Height="5"
                    Margin="12,0,0,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                <TextBlock
                    Text="{Binding StatusText}"
                    Foreground="#475569"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Page>
