<Window
    x:Class="StereoTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="StereoTool · 相机标定与测距"
    Width="1440"
    Height="900"
    MinWidth="1000"
    MinHeight="650"
    FontFamily="Microsoft YaHei UI"
    Background="#F3F6FA"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="148" />
            <ColumnDefinition
                Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Background="#0F172A">
            <DockPanel
                Margin="12,24,12,18">
                <StackPanel
                    DockPanel.Dock="Top"
                    Margin="8,0,0,28">
                    <TextBlock
                        Text="STEREO"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="Bold" />
                    <TextBlock
                        Text="相机标定与测距"
                        Foreground="#94A3B8"
                        FontSize="11"
                        Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel
                    DockPanel.Dock="Bottom"
                    Margin="8,0">
                    <TextBlock
                        Text="StereoTool"
                        Foreground="#64748B"
                        FontSize="11" />
                    <TextBlock
                        Text="OpenCV · 针孔模型"
                        Foreground="#64748B"
                        FontSize="10"
                        Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel>
                    <Button
                        Command="{Binding NavigateMonoCalibrationCommand}"
                        HorizontalContentAlignment="Left"
                        Padding="12,12"
                        Margin="0,0,0,8"
                        BorderThickness="0">
                        <Button.Style>
                            <Style
                                TargetType="Button"
                                BasedOn="{StaticResource {x:Type Button}}">
                                <Setter
                                    Property="Background"
                                    Value="Transparent" />
                                <Setter
                                    Property="Foreground"
                                    Value="#CBD5E1" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedNavItem}"
                                        Value="单目标定">
                                        <Setter
                                            Property="Background"
                                            Value="#2563EB" />
                                        <Setter
                                            Property="Foreground"
                                            Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel
                            Orientation="Horizontal">
                            <TextBlock
                                Text="01"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Opacity="0.6"
                                Margin="0,0,10,0" />
                            <TextBlock
                                Text="单目标定"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding NavigateCalibrationCommand}"
                        HorizontalContentAlignment="Left"
                        Padding="12,12"
                        Margin="0,0,0,8"
                        BorderThickness="0">
                        <Button.Style>
                            <Style
                                TargetType="Button"
                                BasedOn="{StaticResource {x:Type Button}}">
                                <Setter
                                    Property="Background"
                                    Value="Transparent" />
                                <Setter
                                    Property="Foreground"
                                    Value="#CBD5E1" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedNavItem}"
                                        Value="标定">
                                        <Setter
                                            Property="Background"
                                            Value="#2563EB" />
                                        <Setter
                                            Property="Foreground"
                                            Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel
                            Orientation="Horizontal">
                            <TextBlock
                                Text="02"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Opacity="0.6"
                                Margin="0,0,10,0" />
                            <TextBlock
                                Text="双目标定"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding NavigateDistanceCommand}"
                        HorizontalContentAlignment="Left"
                        Padding="12,12"
                        Margin="0,0,0,8"
                        BorderThickness="0">
                        <Button.Style>
                            <Style
                                TargetType="Button"
                                BasedOn="{StaticResource {x:Type Button}}">
                                <Setter
                                    Property="Background"
                                    Value="Transparent" />
                                <Setter
                                    Property="Foreground"
                                    Value="#CBD5E1" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedNavItem}"
                                        Value="测距">
                                        <Setter
                                            Property="Background"
                                            Value="#2563EB" />
                                        <Setter
                                            Property="Foreground"
                                            Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel
                            Orientation="Horizontal">
                            <TextBlock
                                Text="03"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Opacity="0.6"
                                Margin="0,0,10,0" />
                            <TextBlock
                                Text="双目测距"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Frame
            x:Name="MainFrame"
            Grid.Column="1"
            NavigationUIVisibility="Hidden" />
    </Grid>
</Window>